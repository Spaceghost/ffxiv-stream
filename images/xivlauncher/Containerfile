# xivstream's Wolf app: XIVLauncher.Core on games-on-whales' base-app, which
# starts sway inside Wolf's virtual compositor (RUN_SWAY=1) and runs
# /opt/gow/startup-app.sh as the retro user. Wolf mounts
# /etc/wolf/profile_data/<profile>/<app> as /home/retro, so the game install and
# the login persist across sessions.
FROM ghcr.io/games-on-whales/base-app:edge

ARG XIVLAUNCHER_URL=https://github.com/goatcorp/XIVLauncher.Core/releases/latest/download/XIVLauncher.Core.tar.gz

RUN apt-get update -q \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends \
      curl ca-certificates libsecret-1-0 gnome-keyring dbus libvulkan1 mesa-vulkan-drivers \
 && mkdir -p /opt/xivlauncher \
 && curl -fsSL "$XIVLAUNCHER_URL" | tar -xz -C /opt/xivlauncher \
 && rm -rf /var/lib/apt/lists/*

COPY startup-app.sh /opt/gow/startup-app.sh
RUN chmod 755 /opt/gow/startup-app.sh

ENV XDG_RUNTIME_DIR=/tmp/.X11-unix
