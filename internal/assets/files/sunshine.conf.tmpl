# ffxiv-stream: Sunshine for the headless session. (Generated by ffxiv-stream;
# adapter_name is rewritten at every start with the streaming GPU's node.)
sunshine_name = {{.Stream.Name}}
{{- if .Headless}}
capture = wlr
{{- end}}
{{- if .Encoder}}
encoder = {{.Encoder}}
{{- end}}
port = {{.Stream.PortBase}}
# Present every client pad as an Xbox 360 pad unless told otherwise: Wine
# reads that over plain evdev; DualSense/DS4 emulation needs /dev/hidraw.
gamepad = {{.Stream.Gamepad}}
# Cap what is encoded whatever the client asks: phones and tablets on Wi-Fi
# lose packets well below what Moonlight may request, and lost video packets
# look like flicker. (kbit/s)
max_bitrate = {{.Stream.MaxBitrateKbps}}
{{- if eq .Stream.Codecs "h264"}}
# H.264 only: the most widely decodable; some Linux clients show cycling
# colours on hardware HEVC decode.
hevc_mode = 1
av1_mode = 1
{{- end}}
