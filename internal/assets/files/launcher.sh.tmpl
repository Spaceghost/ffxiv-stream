#!/bin/sh
# xivstream: runs inside sway. The launcher, and through it the game, as
# ordinary sway clients; sway's for_window rules make them fullscreen on the
# output the stream captures. (Generated by xivstream.)
#
# No nested gamescope: on NVIDIA it makes sway keep ~64 KiB of VRAM per frame
# while its window is visible, filling an 8 GB card in about half an hour. The
# frame cap it provided is DXVK's job instead (more than the output's rate is
# wasted on a stream).
#
# Looped because the stream is the only way in: XIVLauncher exits when the
# game does (or when closed), and a session with nothing on screen would need
# a shell to recover.
set -u
export DXVK_FRAME_RATE={{.Game.FPS}}
while :; do
    {{.LauncherCommand}}
    sleep 2
done
