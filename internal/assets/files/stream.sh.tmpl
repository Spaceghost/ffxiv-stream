#!/bin/sh
# ffxiv-stream: the streaming server, started by sway rather than beside it:
# it captures through wlr-screencopy, so it needs WAYLAND_DISPLAY for the
# compositor that owns the output, and wlroots picks that socket name itself.
# Launching it as a sway child makes the name right without guessing it.
# (Generated by ffxiv-stream.)
#
# Looped: sway runs this once, and a server that crashed or was restarted must
# come back without a new session.
{{- if eq .Backend "sunshine"}}
conf=$HOME/.config/sunshine/sunshine.conf

while :; do
    # Capture imports sway's frames through a DRM render node, and Sunshine
    # defaults to renderD128, which is not necessarily the streaming GPU (a
    # black stream). The node is found at every start because its number
    # depends on how the GPU was attached.
    node=$(/usr/local/bin/ffxiv-stream render-node 2>/dev/null)
    if [ -n "$node" ]; then
        grep -v "^adapter_name" "$conf" > "$conf.new"
        echo "adapter_name = $node" >> "$conf.new"
        mv "$conf.new" "$conf"
    fi
    echo "=== $(date -Is) starting sunshine on ${WAYLAND_DISPLAY:-?}, adapter ${node:-default} ==="
{{- if .NVIDIA}}
    # dmabuf-wait (/usr/local/lib/ffxiv-stream/dmabuf-wait.c): NVIDIA's EGL
    # ignores the implicit fence on captured dma-bufs, so under load Sunshine
    # read frames sway had not finished copying (black flicker). The Sunshine
    # package gives the binary file capabilities, so it runs in secure-exec
    # mode, where glibc preloads only a bare name from the system library
    # directory, set-user-ID; hence the install location and mode.
    LD_PRELOAD=libdmabuf-wait.so sunshine
{{- else}}
    sunshine
{{- end}}
    sleep 2
done
{{- else if eq .Backend "selkies"}}
# Selkies 2.x: --wayland=true with --wayland-host-display captures this sway by
# screencopy straight into the encoder (without --wayland it captures X11,
# which here is sway's rootless Xwayland), and injects keyboard and mouse
# through sway's virtual-keyboard/pointer protocols. The stream goes to any
# browser on one port over WebSockets (no STUN/TURN on a LAN or a tailnet).
# HTTPS because browsers only allow gamepads, clipboard and pointer lock in a
# secure context; it makes a self-signed certificate on first start. The
# password comes from the environment (selkies.env, mode 600), never the
# command line, where any process could read it.
set -a; . "$HOME/.config/ffxiv-stream/selkies.env"; set +a
while :; do
    echo "=== $(date -Is) starting selkies on ${WAYLAND_DISPLAY:-?} ==="
    selkies --wayland=true --wayland-host-display="$WAYLAND_DISPLAY" --public --port={{.Selkies.Port}} \
        --enable-https=true --enable-resize=false --encoder=h264enc --basic-auth-user={{.Selkies.User}}
    sleep 2
done
{{- end}}
