#!/bin/sh
# xivstream: the headless session. A sway holding one virtual output, which
# the streaming server captures and the launcher and game draw on.
# (Generated by xivstream; edit /etc/xivstream/config.toml and re-run
# `xivstream apply` instead of this file.)
#
# sway rather than gamescope: gamescope does not implement wlr-screencopy, and
# with no scanout kmsgrab has no framebuffer either, so it gives a streaming
# server nothing to capture. sway does implement it.
set -eu
export FFXIV_W={{.Game.Width}} FFXIV_H={{.Game.Height}} FFXIV_FPS={{.Game.FPS}}

# libinput alongside headless: the streaming server injects the client's
# keyboard, mouse and pads as virtual evdev devices, and without libinput sway
# never reads them. {{if .InContainer}}There is no seat in a container, so libseat opens the devices
# directly (the session user is in the input group) instead of asking logind.
export LIBSEAT_BACKEND=noop
{{end -}}
export WLR_BACKENDS=headless,libinput
export WLR_RENDERER={{if .NVIDIA}}vulkan{{else}}gles2{{end}}
# The server creates its devices only after sway is up.
export WLR_LIBINPUT_NO_DEVICES=1
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
mkdir -p "$XDG_RUNTIME_DIR"; chmod 700 "$XDG_RUNTIME_DIR"

conf=$XDG_RUNTIME_DIR/xivstream-sway.conf
printf 'output HEADLESS-1 mode %sx%s@%sHz position 0 0\n\n' "$FFXIV_W" "$FFXIV_H" "$FFXIV_FPS" > "$conf"
cat /etc/xivstream/sway.conf >> "$conf"
exec sway -c "$conf"
