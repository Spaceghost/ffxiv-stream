# ffxiv-stream: the headless session's sway. Not a desktop: it exists so that
# something implementing wlr-screencopy owns an output. (Generated by
# ffxiv-stream.)
#
# The `output` line is prepended at session start with the real geometry: sway
# does not expand ${w}-style variables in a mode, and rejects the mode.

default_border none
default_floating_border none
gaps inner 0
focus_follows_mouse no
# Nothing may steal the output from the game.
for_window [app_id=".*"] fullscreen enable
for_window [class=".*"] fullscreen enable

exec /usr/local/lib/ffxiv-stream/launcher
exec /usr/local/lib/ffxiv-stream/stream

# The client's relative mouse carries movement its own desktop has already
# accelerated; accelerating it again here makes the pointer too fast.
input type:pointer {
    accel_profile flat
    pointer_accel 0
}
